<!-- The test player loads its assets through Addressables, which makes some
     of its operations by reflection. Keeps them from being stripped.
     The colliders are for the pointer and worldspace tests, since a project
     with no collider in its scenes strips physics out of the player.
     EditorTests/TestLinkXml hands this to the linker. -->
<linker>
  <assembly fullname="Unity.ResourceManager" preserve="all" />
  <assembly fullname="Unity.Addressables" preserve="all" />
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.MeshCollider" preserve="all" />
    <type fullname="UnityEngine.BoxCollider" preserve="all" />
  </assembly>
</linker>
